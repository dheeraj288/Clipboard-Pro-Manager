{
  "manifest_version": 3,
  "name": "Clipboard Pro",
  "version": "3.0.0",
  "description": "Advanced clipboard manager with smart UI",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}